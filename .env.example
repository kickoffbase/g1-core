# ── Personality ────────────────────────────────────────────────────────
# Slug of a file in personalities/<slug>.json. Switch live via:
#   curl -X POST http://127.0.0.1:8766/control/personality -d '{"slug":"kickoff"}'
# The chosen slug is persisted to state/active_personality and survives restart.
PERSONALITY=nickk

# ── ElevenLabs (required) ──────────────────────────────────────────────
ELEVENLABS_API_KEY=sk_4ec238d11e0613a2028d351d0d0231151d67401a7a7c85b8
ELEVENLABS_VOICE_ID=sfskE8Nmcqu8XXVarnOA
ELEVENLABS_MODEL=eleven_flash_v2_5
ELEVENLABS_STABILITY=0.4
ELEVENLABS_SIMILARITY=0.75
ELEVENLABS_STYLE=0.4
ELEVENLABS_SPEED=1.0

# ── Audio output ───────────────────────────────────────────────────────
# unitree = built-in G1 speaker (needs Unitree DDS)
# system  = host audio sink (PulseAudio/ALSA → AUX / Bluetooth / USB)
# both    = both at once
AUDIO_OUTPUT=system
SYSTEM_AUDIO_CMD=aplay -q -t raw -f S16_LE -r 16000 -c 1
SYSTEM_AUDIO_FALLBACK_CMD=aplay -q -t raw -f S16_LE -r 16000 -c 1

# ── PulseAudio sink switcher (builtin G1 chest ↔ external JBL) ─────────
# Run `pactl list sinks short` on the Orin and paste the sink names.
# Empty = the corresponding mode no-ops. AUDIO_SINK_DEFAULT decides which
# sink is selected before each utterance when AUDIO_OUTPUT uses 'system'.
# Flip live via:  POST /bluetooth/sink {"mode":"jbl"}
#
# Defaults below assume the standard G1 Orin chest sink and the JBL
# whose MAC is 90:F2:60:BA:29:BB (PulseAudio uses underscores in the
# sink name). Verify on the Orin with `pactl list sinks short`; if the
# names differ, paste the exact strings from there.
AUDIO_SINK_BUILTIN=alsa_output.platform-sound.analog-stereo
AUDIO_SINK_JBL=bluez_sink.90_F2_60_BA_29_BB.a2dp_sink
AUDIO_SINK_DEFAULT=jbl

# Silence (ms) prepended to every utterance. Bluetooth speakers need
# ~150-300 ms to leave standby — without preroll the first phoneme is
# eaten ('…ello' instead of 'hello'). Bump to 400-500 if your JBL still
# clips the first letter; set 0 to disable.
AUDIO_PREROLL_MS=250

# ── Bluetooth speaker auto-reconnect ───────────────────────────────────
# Pair from anywhere via:
#   POST /bluetooth/scan        → list devices
#   POST /bluetooth/connect     → {"mac":"AA:BB:..."}
# (or one-shot from the shell:  bash scripts/bt-connect.sh AA:BB:...)
# When BLUETOOTH_MAC is set the watchdog reconnects on link loss.
BLUETOOTH_MAC=90:F2:60:BA:29:BB
BLUETOOTH_AUTORECONNECT=true

# ── Robot DDS ──────────────────────────────────────────────────────────
# Set ROBOT_ENABLED=false to skip Unitree SDK entirely (handy for
# dev machines or when DDS itself is sick — webhook still works,
# audio still plays via the system sink).
ROBOT_ENABLED=true
NETWORK_INTERFACE=eth0
ROBOT_VOLUME=100

# ── Webhook ────────────────────────────────────────────────────────────
# Bind 0.0.0.0 for LAN access. Defaults to port 8766 so g1-core can run
# alongside the legacy g1-brain (which holds 8765).
# IMPORTANT: generate a real key before exposing the tunnel publicly:
#   openssl rand -hex 16
# Leaving it blank means anyone who guesses the ngrok URL can make the
# robot talk.
WEBHOOK_HOST=0.0.0.0
WEBHOOK_PORT=8766
WEBHOOK_API_KEY=hook

# ── ngrok tunnel ───────────────────────────────────────────────────────
# Reserve a free domain at https://dashboard.ngrok.com/domains for a
# stable public URL — clients then never need to be reconfigured.
NGROK_ENABLED=true
NGROK_DOMAIN=cork-jawless-chalice.ngrok-free.dev

# ── Watchdog ───────────────────────────────────────────────────────────
WATCHDOG_INTERVAL_S=15
