# Force LF line endings on every shell-related file. CRLF in a .sh
# breaks bash with cryptic `$'\r': command not found` errors, and CRLF
# in a systemd unit file breaks `systemctl` with equally cryptic
# parsing errors. Make sure the editor / git / cross-platform copies
# never reintroduce them.
*               text=auto eol=lf
*.sh            text eol=lf
*.service       text eol=lf
*.py            text eol=lf
*.json          text eol=lf
*.md            text eol=lf
*.env           text eol=lf
*.example       text eol=lf
.gitattributes  text eol=lf
.editorconfig   text eol=lf
.gitignore      text eol=lf
